# Backend configuration. Local: copy to server/.env (or the repo root as .env). Never commit the real file.
# On Vercel: set these in Project Settings > Environment Variables instead (the .env file is not used there).
NODE_ENV=development
PORT=4000

# MongoDB connection string. Leave empty to run WITHOUT persistence:
# the typing test still works, persistence endpoints answer 503.
MONGODB_URI=

# Browser origins (besides the server's own origin) that may call the API, comma separated, no trailing slash.
# Same-origin requests are always allowed, so on Vercel you normally do not need this.
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the server (0 = none). Defaults to 1 automatically on Vercel.
TRUST_PROXY=0

# Rate limits per IP per window
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
WRITE_LIMIT_MAX=20
