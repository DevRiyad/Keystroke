{
  "name": "typing-test-server",
  "private": true,
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.5.0",
    "mongoose": "8.9.5"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.9"
  }
}
